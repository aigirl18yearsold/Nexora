import 'package:flutter/material.dart';

import 'category_screen.dart';
import 'profile_screen.dart';

class HomeScreen extends StatefulWidget {
  HomeScreen()({super.key});

  @override
  State<HomeScreen> createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen> {
  final TextEditingController searchController =
      TextEditingController();

  final List<Map<String, dynamic>> opportunities = [
    {
      'title': 'Global AI Hackathon',
      'category': 'Hackathon',
      'icon': Icons.code,
    },
    {
      'title': 'Future Leaders Scholarship',
      'category': 'Scholarship',
      'icon': Icons.school,
    },
    {
      'title': 'MIT Summer Research',
      'category': 'Research',
      'icon': Icons.science,
    },
    {
      'title': 'Global Student Competition',
      'category': 'Competition',
      'icon': Icons.emoji_events,
    },
    {
      'title': 'Technology Internship',
      'category': 'Internship',
      'icon': Icons.work,
    },
  ];

  List<Map<String, dynamic>> filteredOpportunities = [];

  @override
  void initState() {
    super.initState();
    filteredOpportunities = opportunities;
    searchController.addListener(searchOpportunities);
  }

  @override
  void dispose() {
    searchController.removeListener(searchOpportunities);
    searchController.dispose();
    super.dispose();
  }

  void searchOpportunities() {
    final query = searchController.text.toLowerCase().trim();

    setState(() {
      if (query.isEmpty) {
        filteredOpportunities = opportunities;
      } else {
        filteredOpportunities = opportunities.where((item) {
          return item['title']
                  .toString()
                  .toLowerCase()
                  .contains(query) ||
              item['category']
                  .toString()
                  .toLowerCase()
                  .contains(query);
        }).toList();
      }
    });
  }

  void openCategory(
    BuildContext context,
    String category,
    IconData icon,
  ) {
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (context) => CategoryScreen(
          category: category,
          icon: icon,
        ),
      ),
    );
  }

  void openProfile(BuildContext context) {
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (context) => const ProfileScreen(),
      ),
    );
  }

  void openNotifications(BuildContext context) {
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (context) => const NotificationsScreen(),
      ),
    );
  }

  void showOpportunity(
    BuildContext context,
    String title,
    String category,
    IconData icon,
  ) {
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (context) => OpportunityDetailsScreen(
          title: title,
          category: category,
          icon: icon,
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text(
          "Nexora",
          style: TextStyle(
            fontWeight: FontWeight.bold,
          ),
        ),
        centerTitle: false,
        actions: [
          IconButton(
            tooltip: "Notifications",
            onPressed: () {
              openNotifications(context);
            },
            icon: const Icon(
              Icons.notifications_none,
            ),
          ),
          IconButton(
            tooltip: "Profile",
            onPressed: () {
              openProfile(context);
            },
            icon: const Icon(
              Icons.person_outline,
            ),
          ),
        ],
      ),

      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16),

        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text(
              "Discover Your Next Opportunity",
              style: TextStyle(
                fontSize: 30,
                fontWeight: FontWeight.bold,
              ),
            ),

            const SizedBox(height: 8),

            const Text(
              "Find scholarships, hackathons, internships, "
              "competitions, and more.",
              style: TextStyle(
                fontSize: 16,
              ),
            ),

            const SizedBox(height: 25),

            TextField(
              controller: searchController,
              decoration: InputDecoration(
                hintText: "Search opportunities...",
                prefixIcon: const Icon(Icons.search),
                suffixIcon: searchController.text.isNotEmpty
                    ? IconButton(
                        onPressed: () {
                          searchController.clear();
                        },
                        icon: const Icon(Icons.clear),
                      )
                    : null,
                border: OutlineInputBorder(
                  borderRadius: BorderRadius.circular(15),
                ),
              ),
            ),

            const SizedBox(height: 30),

            const Text(
              "Explore",
              style: TextStyle(
                fontSize: 24,
                fontWeight: FontWeight.bold,
              ),
            ),

            const SizedBox(height: 15),

            GridView.count(
              crossAxisCount: 2,
              crossAxisSpacing: 12,
              mainAxisSpacing: 12,
              shrinkWrap: true,
              physics: const NeverScrollableScrollPhysics(),
              childAspectRatio: 1.25,

              children: [
                _categoryCard(
                  context,
                  "Scholarships",
                  Icons.school,
                ),

                _categoryCard(
                  context,
                  "Hackathons",
                  Icons.code,
                ),

                _categoryCard(
                  context,
                  "Internships",
                  Icons.work,
                ),

                _categoryCard(
                  context,
                  "Competitions",
                  Icons.emoji_events,
                ),

                _categoryCard(
                  context,
                  "Research",
                  Icons.science,
                ),

                _categoryCard(
                  context,
                  "Olympiads",
                  Icons.military_tech,
                ),
              ],
            ),

            const SizedBox(height: 35),

            Text(
              searchController.text.isEmpty
                  ? "Featured Opportunities"
                  : "Search Results",
              style: const TextStyle(
                fontSize: 24,
                fontWeight: FontWeight.bold,
              ),
            ),

            const SizedBox(height: 15),

            if (filteredOpportunities.isEmpty)
              const Center(
                child: Padding(
                  padding: EdgeInsets.all(30),
                  child: Column(
                    children: [
                      Icon(
                        Icons.search_off,
                        size: 50,
                      ),
                      SizedBox(height: 10),
                      Text(
                        "No opportunities found.",
                        style: TextStyle(
                          fontSize: 18,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                    ],
                  ),
                ),
              ),

            ...filteredOpportunities.map(
              (item) => Card(
                margin: const EdgeInsets.only(
                  bottom: 12,
                ),

                child: ListTile(
                  contentPadding: const EdgeInsets.all(12),

                  leading: CircleAvatar(
                    child: Icon(
                      item['icon'] as IconData,
                    ),
                  ),

                  title: Text(
                    item['title'].toString(),
                    style: const TextStyle(
                      fontWeight: FontWeight.bold,
                    ),
                  ),

                  subtitle: Text(
                    "Nexora Opportunities • "
                    "${item['category']}",
                  ),

                  trailing: const Icon(
                    Icons.arrow_forward_ios,
                    size: 18,
                  ),

                  onTap: () {
                    showOpportunity(
                      context,
                      item['title'].toString(),
                      item['category'].toString(),
                      item['icon'] as IconData,
                    );
                  },
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _categoryCard(
    BuildContext context,
    String title,
    IconData icon,
  ) {
    return Card(
      elevation: 2,

      child: InkWell(
        borderRadius: BorderRadius.circular(12),

        onTap: () {
          openCategory(
            context,
            title,
            icon,
          );
        },

        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Icon(
              icon,
              size: 42,
            ),

            const SizedBox(height: 12),

            Text(
              title,
              style: const TextStyle(
                fontSize: 17,
                fontWeight: FontWeight.bold,
              ),
            ),
          ],
        ),
      ),
    );
  }
}


