name: Fix Android Desugaring

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  fix-android:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Nexora
        uses: actions/checkout@v4

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable

      - name: Fix Android Gradle configuration
        run: |
          python3 - <<'PY'
          from pathlib import Path

          path = Path("android/app/build.gradle.kts")
          text = path.read_text()

          if "isCoreLibraryDesugaringEnabled = true" not in text:
              text = text.replace(
                  "targetCompatibility = JavaVersion.VERSION_17",
                  "targetCompatibility = JavaVersion.VERSION_17\n        isCoreLibraryDesugaringEnabled = true"
              )

          dependency = """dependencies {
              coreLibraryDesugaring("com.android.tools:desugar_jdk_libs:2.1.4")
          }

          """

          if "coreLibraryDesugaring(" not in text:
              text = text.replace("kotlin {", dependency + "kotlin {")

          path.write_text(text)
          PY

      - name: Verify configuration
        run: |
          grep -n "isCoreLibraryDesugaringEnabled" android/app/build.gradle.kts
          grep -n "coreLibraryDesugaring" android/app/build.gradle.kts

      - name: Commit Android fix
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add android/app/build.gradle.kts
          if git diff --cached --quiet; then
            echo "No changes needed."
          else
            git commit -m "Fix Android core library desugaring"
            git push
          fi
